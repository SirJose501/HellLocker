# Panel and preset previews.
msgid "Preset {}"
msgstr "預設 {}"

msgid "Stratagem {}"
msgstr "戰略配備 {}"

msgid "Booster"
msgstr "強化套件"

msgid "Fallback Booster"
msgstr "備用強化套件"

msgid "Helmet"
msgstr "頭盔"

msgid "Armor"
msgstr "裝甲"

msgid "Cape"
msgstr "披肩"

msgid "Primary"
msgstr "主武器"

msgid "Secondary"
msgstr "次要武器"

msgid "Throwable"
msgstr "投擲武器"

msgid "Settings"
msgstr "設定"

msgid "Hide panel"
msgstr "隱藏面板"

msgid "Preview unavailable"
msgstr "無法預覽"

msgid "Not saved"
msgstr "尚未儲存"

msgid "Loading previews…"
msgstr "正在載入預覽…"

msgid "+ New preset"
msgstr "+ 新增預設"

msgid "Select a preset"
msgstr "選擇預設"

msgid "No presets"
msgstr "尚無預設"

msgid "Cut"
msgstr "剪下"

msgid "Copy"
msgstr "複製"

msgid "Paste"
msgstr "貼上"

msgid "Select all"
msgstr "全選"

msgid "Preset name"
msgstr "預設名稱"

msgid "Rename preset"
msgstr "重新命名預設"

msgid "Delete preset"
msgstr "刪除預設"

msgid "Stratagems & Booster"
msgstr "戰略配備與強化套件"

msgid "Use + New preset to get started."
msgstr "按一下「+ 新增預設」開始使用。"

msgid "Equipment"
msgstr "裝備"

msgid "Start from either loadout page."
msgstr "可從任一配裝頁面開始。"

msgid "Select sections to save or apply."
msgstr "選擇要儲存或套用的內容。"

msgid "Some shortcuts are unavailable. Change them in Settings > Shortcuts."
msgstr "部分快速鍵無法使用。請至「設定 > 快速鍵」修改。"

msgid "Show / hide panel"
msgstr "顯示 / 隱藏面板"

msgid "Global shortcut"
msgstr "全域快速鍵"

msgid "Save preset"
msgstr "儲存預設"

msgid "Save Stratagems"
msgstr "儲存戰略配備"

msgid "Save equipment"
msgstr "儲存裝備"

msgid "Select content"
msgstr "選擇內容"

msgid "Fill all four Stratagem slots before saving."
msgstr "儲存前，請填滿四個戰略配備欄位。"

msgid "Apply all"
msgstr "套用全部"

msgid "Apply Stratagems"
msgstr "套用戰略配備"

msgid "Apply equipment"
msgstr "套用裝備"

# General settings.
msgid "General"
msgstr "一般"

msgid "Shortcuts"
msgstr "快速鍵"

msgid "Apply Stratagems in saved order"
msgstr "依儲存順序套用戰略配備"

msgid "Only when all four slots start empty."
msgstr "僅在四個欄位初始皆為空白時生效。"

msgid "Auto ready up"
msgstr "自動準備就緒"

msgid "Ready up after successfully applying a Booster."
msgstr "成功套用強化套件後，自動準備就緒。"

msgid "Save fallback Booster when taken"
msgstr "強化套件被佔用時儲存備用套件"

msgid "Wait for your selection, then save it as a fallback."
msgstr "等待你選擇強化套件，再儲存為備用。"

msgid "Display"
msgstr "螢幕"

msgid "Follow game (automatic)"
msgstr "跟隨遊戲（自動）"

msgid "Saved display (unavailable)"
msgstr "已儲存的螢幕（無法使用）"

msgid "Primary display"
msgstr "主要螢幕"

msgid "Used for the panel and action status."
msgstr "用於顯示面板與操作狀態。"

msgid "Language"
msgstr "語言"

msgid "Follow system"
msgstr "跟隨系統"

msgid "Currently unavailable:\n"
msgstr "目前無法使用：\n"

msgid "Saving…"
msgstr "正在儲存…"

msgid "Save"
msgstr "儲存"

# Shortcut settings.
msgid "Open panel"
msgstr "開啟面板"

msgid "Press keys…"
msgstr "請按下快速鍵…"

msgid "Unassigned"
msgstr "尚未指派"

msgid "Clear shortcut"
msgstr "清除快速鍵"

msgid "Click a shortcut and press your keys. Esc cancels recording."
msgstr "按一下快速鍵，再按下所需按鍵。按 Esc 取消錄製。"

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "面板快速鍵全域有效；預設快速鍵僅在遊戲或面板中有效。"

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 是數字鍵台按鍵。請保持 Num Lock 開啟，避免搭配 Shift 使用。"

# Dialogs and fixed error controls.
msgid "Delete preset?"
msgstr "刪除預設？"

msgid "Its saved content and shortcut will be deleted. This cannot be undone."
msgstr "此預設儲存的內容與快速鍵將一併刪除。此操作無法復原。"

msgid "Cancel"
msgstr "取消"

msgid "Delete"
msgstr "刪除"

msgid "Copied"
msgstr "已複製"

msgid "Copy details"
msgstr "複製詳細資訊"

msgid "Dismiss last failure"
msgstr "關閉上次錯誤提示"

# Tray.
msgid "Exit"
msgstr "結束"

# HellLocker additions. Faction and sub-faction names follow the Chinese
# Helldivers wiki (helldivers.wiki.gg/zh).

msgid "Show / hide"
msgstr "顯示 / 隱藏"

msgid "Global shortcut: shows or hides the panel from anywhere, also in game. Change it in Settings."
msgstr "全域性快捷鍵：在任何地方（包括遊戲中）顯示或隱藏面板。可在設定中更改。"

msgid "Scan equipment"
msgstr "掃描裝備"

msgid "Walks through every equipment list once and keeps each item's picture, so saving presets is quicker. Start on a loadout page and leave the game alone for a few minutes. Run it again after game updates."
msgstr "逐一瀏覽每個裝備列表並儲存每件物品的圖片，讓儲存預設更快。請在配裝頁面開始，並在幾分鐘內不要操作遊戲。遊戲更新後請再次執行。"

msgid "All factions"
msgstr "所有陣營"

msgid "Pick a faction first"
msgstr "請先選擇陣營"

msgid "All sub-factions"
msgstr "所有分支"

msgid "All missions"
msgstr "所有任務"

msgid "Search presets"
msgstr "搜尋預設"

msgid "Clear search"
msgstr "清除搜尋"

msgid "↑↓ / W S  ·  A / D faction  ·  Q / E mission"
msgstr "↑↓ / W S  ·  A / D 陣營  ·  Q / E 任務"

msgid "Keys while the panel has focus: select a preset, change the faction filter, change the mission filter"
msgstr "面板獲得焦點時的按鍵：選擇預設、切換陣營篩選、切換任務篩選"

msgid "Faction"
msgstr "陣營"

msgid "Sub-faction"
msgstr "分支"

msgid "Mission"
msgstr "任務"

msgid "Unticked: left as they are when saving and applying"
msgstr "未勾選的部位在儲存和應用時保持不變"

msgid "No presets match the search."
msgstr "沒有符合搜尋的預設。"

msgid "No presets for this filter yet. Use + New preset to make one."
msgstr "此篩選下還沒有預設。點選“+ 新建預設”建立一個。"

msgid "Terminids"
msgstr "終結族"

msgid "Automatons"
msgstr "機器人"

msgid "Illuminate"
msgstr "光能者"

msgid "Any faction"
msgstr "任意陣營"

msgid "Standard"
msgstr "標準"

msgid "Blitz"
msgstr "閃電戰"

msgid "Eradicate"
msgstr "殲滅"

msgid "Defense"
msgstr "防禦"

msgid "Any mission"
msgstr "任意任務"

msgid "Predator Strain"
msgstr "掠食變種"

msgid "Spore Burst Strain"
msgstr "孢裂變種"

msgid "Rupture Strain"
msgstr "爆裂變種"

msgid "Jet Brigade"
msgstr "噴氣旅"

msgid "Incineration Corps"
msgstr "熾灼部隊"

msgid "Cyborg Legion"
msgstr "生化人軍團"

msgid "Mindless Masses"
msgstr "無腦群氓"

msgid "Appropriators"
msgstr "佔領者"

msgid "Vote Snatchers"
msgstr "竊票者"

msgid "Any sub-faction"
msgstr "任意分支"

msgid "Keep the panel open"
msgstr "保持面板開啟"

msgid "Stays up when you click the game, so it can sit on another monitor. Hide it with the panel shortcut."
msgstr "點選遊戲時面板不會隱藏，可以放在另一臺顯示器上。用面板快捷鍵隱藏它。"

msgid "Background"
msgstr "背景"

msgid "How solid the background art is. 10% is almost see-through, 100% is solid. Shows as you drag; Save keeps it."
msgstr "背景圖的不透明度。10% 幾乎透明，100% 完全不透明。拖動時即可預覽，點選儲存後生效。"

msgid "Panel size"
msgstr "面板大小"

msgid "On top of the Windows display scale. Applies after HellLocker restarts."
msgstr "在 Windows 顯示縮放的基礎上調整。重啟 HellLocker 後生效。"

msgid "+ New folder"
msgstr "+ 新增資料夾"

msgid "Folder name"
msgstr "資料夾名稱"

msgid "Rename folder"
msgstr "重新命名資料夾"

msgid "Delete folder (its presets are kept)"
msgstr "刪除資料夾（其中的預設會保留）"

msgid "SETTINGS"
msgstr "設定"

msgid "Close"
msgstr "關閉"

msgid "Gameplay"
msgstr "遊戲"

msgid "Panel"
msgstr "面板"

msgid "Help"
msgstr "說明"

msgid "APPLYING PRESETS"
msgstr "套用預設"

msgid "Only when all four Stratagem slots start empty."
msgstr "僅當四個戰備欄位開始時皆為空。"

msgid "Automatic Readying"
msgstr "自動準備"

msgid "Ready up after a preset with a Booster is applied."
msgstr "套用含增益的預設後自動準備。"

msgid "Patient mode"
msgstr "耐心模式"

msgid "Waits up to three times longer for the game. Turn on if menus open slowly or the game hitches and presets stop partway."
msgstr "等待遊戲的時間最多延長到三倍。若選單開啟很慢、遊戲卡頓或預設中途停止，請開啟。"

msgid "SAVING PRESETS"
msgstr "儲存預設"

msgid "Booster Fallbacking"
msgstr "備用增益"

msgid "If the saved Booster is taken, wait for you to pick another and save it as the fallback."
msgstr "若儲存的增益已被占用，等待你選擇另一個並將其儲存為備用。"

msgid "Sound when saved"
msgstr "儲存時播放聲音"

msgid "A short Windows chime when a preset has been saved."
msgstr "預設儲存後播放一聲簡短的 Windows 提示音。"

msgid "Reset this tab"
msgstr "重設此頁"

msgid "BEHAVIOUR"
msgstr "行為"

msgid "Stays up when you click the game, so it can sit on another monitor."
msgstr "點擊遊戲時仍保持顯示，可放在另一台螢幕上。"

msgid "Start with Windows"
msgstr "隨 Windows 啟動"

msgid "Starts HellLocker in the tray when you sign in."
msgstr "登入時在系統匣中啟動 HellLocker。"

msgid "Where the panel and the status pop-up appear."
msgstr "面板和狀態彈窗顯示的位置。"

msgid "Status pop-up"
msgstr "狀態彈窗"

msgid "The small notice that shows progress while the panel is hidden."
msgstr "面板隱藏時顯示進度的小提示。"

msgid "Top right"
msgstr "右上"

msgid "Top left"
msgstr "左上"

msgid "Off"
msgstr "關閉"

msgid "LOOK"
msgstr "外觀"

msgid "On top of Windows display scaling. Applies after a restart."
msgstr "在 Windows 顯示縮放的基礎上。重新啟動後生效。"

msgid "How solid the background art is. Shows as you drag."
msgstr "背景圖的不透明程度。拖曳時即可預覽。"

msgid "Follow system, or pick one."
msgstr "跟隨系統，或選擇一種。"

msgid "REPORT A PROBLEM"
msgstr "回報問題"

msgid "Report a bug"
msgstr "回報錯誤"

msgid "Opens the Bugs tab on the HellLocker Nexus page. Say what you did, and attach app.log and last_failure.zip from the data folder."
msgstr "開啟 HellLocker Nexus 頁面的 Bugs 分頁。請說明你做了什麼，並附上資料夾中的 app.log 和 last_failure.zip。"

msgid "Open Bugs tab"
msgstr "開啟 Bugs 頁"

msgid "Data folder"
msgstr "資料夾"

msgid "Your presets, settings, app.log and last_failure.zip."
msgstr "你的預設、設定、app.log 和 last_failure.zip。"

msgid "Open folder"
msgstr "開啟資料夾"

msgid "System info"
msgstr "系統資訊"

msgid "Copies your HellLocker version, Windows version, displays and game display settings, to paste into a bug report. No names or file paths."
msgstr "複製 HellLocker 版本、Windows 版本、螢幕和遊戲顯示設定，方便貼到錯誤回報中。不含姓名或檔案路徑。"

msgid "YOUR PRESETS"
msgstr "你的預設"

msgid "Back up presets"
msgstr "備份預設"

msgid "Saves every preset, its pictures and your settings into one zip file."
msgstr "將所有預設、圖片和設定儲存到一個 zip 檔中。"

msgid "Save backup…"
msgstr "儲存備份…"

msgid "Restore from a backup"
msgstr "從備份還原"

msgid "Replaces your presets and settings with a backup, then restarts HellLocker. What you have now is kept in backups\\before-restore.zip."
msgstr "用備份取代你的預設和設定，然後重新啟動 HellLocker。目前內容會保存在 backups\\before-restore.zip 中。"

msgid "Restore…"
msgstr "還原…"

msgid "Shortcuts pause while you record one."
msgstr "錄製快捷鍵時其他快捷鍵會暫停。"

msgid "These act right away; Save is only for settings."
msgstr "這些操作會立即執行；「儲存」僅用於設定。"

msgid "Changes apply when you press Save."
msgstr "按「儲存」後變更生效。"

msgid "Also used by another shortcut"
msgstr "與另一個快捷鍵重複"

msgid "Esc cancels"
msgstr "Esc 取消"

msgid "Click a shortcut, then press your keys. The panel shortcut works anywhere; preset shortcuts work in the game or panel."
msgstr "點擊一個快捷鍵，然後按下按鍵。面板快捷鍵在任何地方都有效；預設快捷鍵在遊戲或面板中有效。"

msgid "Num0–Num9 are keypad keys: keep Num Lock on and avoid Shift with them."
msgstr "Num0–Num9 是數字鍵台按鍵：請保持 Num Lock 開啟，並避免與 Shift 組合。"
