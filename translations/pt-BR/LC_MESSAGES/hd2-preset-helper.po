# General settings.
msgid "General"
msgstr "Geral"

msgid "Shortcuts"
msgstr "Atalhos"

msgid "Apply Stratagems in saved order"
msgstr "Aplicar Estratégias na ordem salva"

msgid "Only when all four slots start empty."
msgstr "Só quando os quatro espaços estiverem vazios no início."

msgid "Auto ready up"
msgstr "Pronto automaticamente"

msgid "Ready up after successfully applying a Booster."
msgstr "Marca você como pronto após aplicar um reforçador com sucesso."

msgid "Save fallback Booster when taken"
msgstr "Salvar alternativa se outro usar o reforçador"

msgid "Wait for your selection, then save it as a fallback."
msgstr "Aguarda sua seleção e a salva como alternativa."

msgid "Display"
msgstr "Monitor"

