msgstr "Estratagemas y potenciador"

msgid "Use + New preset to get started."
msgstr "Usa «+ Nuevo preajuste» para empezar."

msgid "Equipment"
msgstr "Equipamiento"

msgid "Start from either loadout page."
msgstr "Empieza desde cualquiera de las dos pantallas de equipamiento."

msgid "Select sections to save or apply."
msgstr "Selecciona las secciones que quieras guardar o aplicar."

msgid "Some shortcuts are unavailable. Change them in Settings > Shortcuts."
msgstr "Algunos atajos no están disponibles. Cámbialos en Ajustes > Atajos."

