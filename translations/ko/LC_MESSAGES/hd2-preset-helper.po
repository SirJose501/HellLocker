# Panel and preset previews.
msgid "Preset {}"
msgstr "프리셋 {}"

msgid "Stratagem {}"
msgstr "스트라타젬 {}"

msgid "Booster"
msgstr "부스터"

msgid "Fallback Booster"
msgstr "대체 부스터"

