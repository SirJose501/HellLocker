msgstr "Estratagemas e impulsionador"

msgid "Use + New preset to get started."
msgstr "Usa «+ Nova predefinição» para começar."

msgid "Equipment"
msgstr "Equipamento"

msgid "Start from either loadout page."
msgstr "Começa em qualquer um dos dois ecrãs de equipamento."

msgid "Select sections to save or apply."
msgstr "Seleciona as secções que queres guardar ou aplicar."

msgid "Some shortcuts are unavailable. Change them in Settings > Shortcuts."
msgstr "Alguns atalhos estão indisponíveis. Altera-os em Definições > Atalhos."

