import "../../assets/LiberationSans-Bold.ttf";
import { Theme } from "theme.slint";
import { NameImage } from "controls.slint";
import { UiText } from "text.slint";

export enum StatusTone { working, success, warning, error }
export struct StatusItem { item-id: string, picture: image, confirmed: bool }

component ItemIcon inherits Rectangle {
    in property <StatusItem> item;
    width: 40px;
    height: 40px;
    Image {
        source: root.item.picture;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        opacity: root.item.confirmed ? 0.65 : 1;
    }
    if (root.item.confirmed): Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 13px;
        height: 13px;
        border-radius: 6px;
        background: Theme.background;
        Path {
            x: 3px; y: 3px;
            width: 8px; height: 7px;
            viewbox-width: 12; viewbox-height: 10;
            commands: "M 1 5 L 4 8 L 11 1";
            fill: transparent;
            stroke: #b8cbb7;
            stroke-width: 1.5px;
        }
    }
}

export component ActionStatus inherits Window {
    title: "HellLocker — Status";
    no-frame: true;
    always-on-top: true;
    resize-border-width: 0px;
    width: 380px;
    height: 124px;
    background: Theme.background;
    in property <string> ui-font-family;
    default-font-family: root.ui-font-family;
    in property <string> preset-label;
    in property <string> preset-number;
    in property <string> message;
    in property <StatusTone> tone;
    private property <color> accent: tone == StatusTone.success ? Theme.success
        : tone == StatusTone.warning ? Theme.warning
        : tone == StatusTone.error ? Theme.error : Theme.accent;
    in property <image> picture;
    // HellLocker 1.9.4: how far the current step is (0 to 1; below 0 = no bar), and
    // the key that stops it.
    in property <float> progress: -1;
    in property <string> stop-key;
    in property <[StatusItem]> stratagems;
    in property <StatusItem> booster;
    Rectangle { border-width: 1px; border-color: Theme.border; }
    Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: root.accent; }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text { text: UiText.preset-title(root.preset-label, root.preset-number); color: root.accent; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
            if (root.tone == StatusTone.working && root.stop-key != ""): HorizontalLayout {
                spacing: 5px;
                Rectangle {
                    width: stop-text.preferred-width + 10px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.inactive;
                    background: Theme.control;
                    stop-text := Text { text: root.stop-key; color: Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: @tr("to stop"); color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
            }
        }
        Text { text: root.message; color: Theme.text; font-size: 13px; min-height: 16px; wrap: word-wrap; overflow: elide; }
        if (root.progress >= 0): Rectangle {
            height: 4px;
            border-radius: 2px;
            background: #ffffff1a;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.progress, 0, 1);
                height: parent.height;
                border-radius: 2px;
                background: root.accent;
                animate width { duration: 200ms; easing: ease-out; }
            }
        }
        if (root.stratagems.length > 0 || root.booster.item-id != ""): HorizontalLayout {
            height: 40px;
            spacing: 8px;
            alignment: start;
            for item in root.stratagems: ItemIcon { item: item; }
            if (root.stratagems.length > 0 && root.booster.item-id != ""): Rectangle {
                width: 12px;
                Rectangle { x: 5px; y: 4px; width: 1px; height: 32px; background: Theme.border; }
            }
            if (root.booster.item-id != ""): ItemIcon { item: root.booster; }
        }
        if (root.picture.width > 0): Rectangle {
            height: 40px;
            NameImage {
                x: 0px;
                y: 0px;
                source: root.picture;
                width: parent.width;
                height: 24px;
                colorize: #ffffff;
            }
        }
    }
}
