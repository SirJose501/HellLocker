import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TagIcon, FactionIcon } from "icons.slint";

// HellLocker: the striped button face (black with faint light-gray diagonal lines), with
// a lighter wash on hover and a dark one when disabled. Sits under the button's content.
component StripedFace inherits Rectangle {
    in property <bool> hovered;
    in property <bool> enabled: true;
    border-radius: 4px;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../assets/button-stripes.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
    }
    Rectangle {
        background: !root.enabled ? #000000a6 : root.hovered ? #ffffff1a : transparent;
    }
}

export component PanelComboBox inherits Rectangle {
    in property <[string]> model;
    in property <[string]> font-families;
    // Font for the choices that have no entry in font-families ("" = the panel's).
    in property <string> font-family;
    // HellLocker: optional icon path commands, one per choice.
    in property <[string]> icons;
    // Optional color per choice; without one, the accent (grey for the first choice).
    in property <[color]> icon-colors;
    // HellLocker: show faction emblems (choice index = faction index) instead of icons.
    in property <bool> faction-icons;
    // HellLocker: emblem pictures, one per choice; an empty one falls back to `icons`.
    in property <[image]> images;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    out property <string> current-value: model[current-index];
    private property <length> scroll-y;
    // HellLocker: fired only for a choice made in the control, not for property updates.
    callback selected(int);
    min-width: 160px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: keys.has-focus || popup.is-open ? Theme.button-outline : #ffd21f8c;
    background: transparent;
    forward-focus: keys;
    accessible-role: combobox;
    accessible-enabled: enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-value: current-value;
    accessible-action-expand => { root.open(); }

    function open() {
        if (root.enabled && root.model.length > 0) {
            keys.focus();
            root.scroll-y = -max(0, root.current-index - 5) * 36px;
            popup.show();
        }
    }
    function select(index: int) {
        if (root.enabled && root.model.length > 0) {
            let chosen = index.clamp(0, root.model.length - 1);
            if (chosen != root.current-index) {
                root.current-index = chosen;
                root.selected(chosen);
            }
        }
    }
    function handle-key(event: KeyEvent) -> EventResult {
        if (!root.enabled) { return reject; }
        if (event.text == Key.UpArrow) { root.select(root.current-index - 1); }
        else if (event.text == Key.DownArrow) { root.select(root.current-index + 1); }
        else if (event.text == Key.Home) { root.select(0); }
        else if (event.text == Key.End) { root.select(root.model.length - 1); }
        else if (event.text == Key.Return || event.text == Key.Space) {
            if (!event.repeat) {
                if (popup.is-open) { popup.close(); } else { root.open(); }
            }
        } else if (popup.is-open && event.text == Key.Escape) { popup.close(); }
        else {
            if (event.text == Key.Tab || event.text == Key.Backtab) { popup.close(); }
            return reject;
        }
        return accept;
    }
    changed current-index => { root.scroll-y = -max(0, root.current-index - 5) * 36px; }
    changed model => {
        root.current-index = root.current-index.clamp(0, max(0, root.model.length - 1));
        root.scroll-y = -max(0, root.current-index - 5) * 36px;
    }

    StripedFace {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        hovered: touch.has-hover;
        enabled: root.enabled;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        if (root.faction-icons): FactionIcon {
            width: 20px;
            height: 20px;
            cross-axis-self-alignment: center;
            faction: root.current-index;
        }
        if (root.images[root.current-index].width > 0): Image {
            width: 22px;
            height: 22px;
            cross-axis-self-alignment: center;
            source: root.images[root.current-index];
            image-fit: contain;
        }
        if (root.icons.length > 0 && !root.faction-icons && root.images[root.current-index].width == 0): TagIcon {
            width: 18px;
            height: 18px;
            cross-axis-self-alignment: center;
            icon: root.icons[root.current-index];
            color: root.icon-colors.length > 0 ? root.icon-colors[root.current-index]
                : root.current-index == 0 ? Theme.text-secondary : Theme.accent;
        }
        Text {
            text: root.current-value;
            font-family: root.font-families[root.current-index] != "" ? root.font-families[root.current-index] : root.font-family;
            color: root.enabled ? Theme.control-text : Theme.text-disabled;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Path {
            width: 12px;
            height: 12px;
            cross-axis-self-alignment: center;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M 2 4 L 6 8 L 10 4";
            fill: transparent;
            stroke: root.enabled ? Theme.control-text : Theme.text-disabled;
            stroke-width: 1.5px;
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { return root.handle-key(event); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open(); }
        scroll-event(event) => {
            if (!keys.has-focus) { return reject; }
            if (event.delta-y < -2px) { root.select(root.current-index + 1); return accept; }
            if (event.delta-y > 2px) { root.select(root.current-index - 1); return accept; }
            return reject;
        }
    }
    popup := PopupWindow {
        y: root.height + 4px;
        width: root.width;
        height: min(6, root.model.length) * 36px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;
        popup-keys := FocusScope {
            key-pressed(event) => { return root.handle-key(event); }
            Rectangle {
                background: Theme.surface;
                border-color: Theme.border-strong;
                border-width: 1px;
                border-radius: 4px;
                ScrollView {
                    x: 4px; y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-y <=> root.scroll-y;
                    content-width: self.visible-width;
                    VerticalLayout {
                        for value[index] in root.model: Rectangle {
                            height: 36px;
                            border-radius: 3px;
                            background: item-touch.has-hover ? Theme.hover
                                : index == root.current-index ? #2d3032 : transparent;
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-item-selectable: true;
                            accessible-item-selected: index == root.current-index;
                            accessible-item-index: index;
                            accessible-action-default => { root.select(index); popup.close(); }
                            if index == root.current-index: Rectangle {
                                x: 2px; y: 10px;
                                width: 3px; height: 16px;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                            if (root.faction-icons): FactionIcon {
                                x: 13px;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                faction: index;
                            }
                            if (root.images[index].width > 0): Image {
                                x: 12px;
                                y: (parent.height - self.height) / 2;
                                width: 22px;
                                height: 22px;
                                source: root.images[index];
                                image-fit: contain;
                            }
                            if (root.icons.length > 0 && !root.faction-icons && root.images[index].width == 0): TagIcon {
                                x: 14px;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                icon: root.icons[index];
                                color: root.icon-colors.length > 0 ? root.icon-colors[index]
                                    : index == 0 ? Theme.text-secondary : Theme.accent;
                            }
                            Text {
                                x: root.icons.length > 0 || root.faction-icons || root.images.length > 0 ? 40px : 14px;
                                width: parent.width - (root.icons.length > 0 || root.faction-icons || root.images.length > 0 ? 50px : 24px);
                                text: value;
                                font-family: root.font-families[index] != "" ? root.font-families[index] : root.font-family;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            item-touch := TouchArea {
                                clicked => { root.select(index); popup.close(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component PanelButton inherits Rectangle {
    in property <string> text;
    in property <string> font-family;
    in property <bool> accent;
    in property <bool> filled;
    in property <bool> enabled: true;
    callback clicked();
    preferred-width: label.preferred-width + 24px;
    border-radius: 4px;
    border-width: keys.has-focus || accent ? 2px : 1px;
    border-color: !enabled ? #ffd21f59 : keys.has-focus ? #fff3b0 : Theme.button-outline;
    // Every button has the striped face; the main action (accent) gets a thicker outline.
    background: transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: keys;
    StripedFace {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        hovered: touch.has-hover;
        enabled: root.enabled;
    }
    label := Text {
        text: root.text;
        font-family: root.font-family;
        color: !root.enabled ? Theme.text-disabled : Theme.button-outline;
        font-weight: root.accent ? 800 : 700;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <bool> outlined;
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border-width: keys.has-focus ? 2px : 1px;
    border-color: !enabled ? #ffd21f59 : keys.has-focus ? #fff3b0 : Theme.button-outline;
    background: transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: keys;
    StripedFace {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        hovered: touch.has-hover;
        enabled: root.enabled;
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: transparent;
        stroke: !root.enabled ? Theme.inactive
            : touch.has-hover || keys.has-focus ? #fff3b0 : Theme.button-outline;
        stroke-width: 1.5px;
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        // Disabled icons still consume clicks over a clickable parent.
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { keys.focus(); root.clicked(); } }
        Tooltip { text: @markdown("\{root.label}"); }
    }
}

export component DeletePresetDialog inherits Rectangle {
    in property <string> preset-title;
    in property <bool> enabled;
    callback confirm();
    callback cancel();
    forward-focus: keys;
    public function focus-dialog() { cancel-button.focus(); }
    background: Theme.surface;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;
    TouchArea { }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 16px;
            Text { text: @tr("Delete preset?"); color: Theme.text; font-size: 21px; }
            Text { text: root.preset-title; color: Theme.text; font-size: 15px; overflow: elide; }
            Text {
                text: @tr("Its saved content and shortcut will be deleted. This cannot be undone.");
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                height: 32px;
                alignment: end;
                spacing: 10px;
                cancel-button := PanelButton { min-width: 86px; text: @tr("Cancel"); filled: true; enabled: root.enabled; clicked => { root.cancel(); } }
                PanelButton { min-width: 86px; text: @tr("Delete"); accent: true; enabled: root.enabled; clicked => { root.confirm(); } }
            }
        }
    }
}

export component NameImage inherits Rectangle {
    in property <image> source;
    in property <color> colorize: Theme.text;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    clip: true;
    Image {
        x: 0px;
        y: 0px;
        source: root.source;
        height: parent.height;
        width: self.height * root.source.width / max(1, root.source.height);
        colorize: root.colorize;
    }
}

// Keep the full error for copying, without growing the panel around long diagnostics.
export component FailureNotice inherits HorizontalLayout {
    in property <string> details;
    callback dismissed();
    private property <bool> copied;
    changed details => { root.copied = false; }
    spacing: 8px;
    height: 36px;
    Rectangle {
        clip: true;
        horizontal-stretch: 1;
        details-text := TextInput {
            text: root.details;
            read-only: true;
            enabled: false;
            wrap: word-wrap;
            vertical-alignment: self.preferred-height <= self.height ? center : top;
            color: #efb09b;
            font-size: 12px;
        }
        Tooltip { text: @markdown("\{root.details}"); }
    }
    VerticalLayout {
        width: 60px;
        alignment: center;
        HorizontalLayout {
            height: 28px;
            spacing: 4px;
            IconButton {
                label: root.copied ? @tr("Copied") : @tr("Copy details");
                path: root.copied ? "M 5 12 L 10 17 L 20 6"
                    : "M 9 9 H 21 V 21 H 9 Z M 5 15 H 3 V 3 H 15 V 5";
                clicked => {
                    details-text.select-all();
                    details-text.copy();
                    details-text.clear-selection();
                    root.copied = true;
                    copy-feedback.restart();
                }
            }
            IconButton {
                label: @tr("Dismiss last failure");
                path: "M 6 6 L 18 18 M 18 6 L 6 18";
                clicked => { root.dismissed(); }
            }
        }
    }
    copy-feedback := Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
}
