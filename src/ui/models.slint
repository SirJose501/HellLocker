// Semantic presentation data; fixed labels are generated by the UI.
export enum ActionScope { selected, stratagems, equipment }
export enum PreviewRole { stratagem, booster, fallback-booster, helmet, armor, cape, primary, secondary, throwable }
// HellLocker: icon / has-icon is an equipment item's picture, when saved with one.
export struct PreviewRow { role: PreviewRole, number: int, picture: image, icon: image, has-icon: bool }
export struct PreviewSection { items: [PreviewRow], error: string, ready: bool, saved: bool }
export struct PresetRow {
    name: string,
    label: string,
    number: string,
    shortcut: string,
    // HellLocker tags: indexes into the faction / mission lists, 0 = any.
    faction: int,
    subfaction: int,
    mission: int,
    stratagems: PreviewSection,
    equipment: PreviewSection,
    // HellLocker: where the row sits in the list, and whether it is inside a folder.
    top: length,
    in-folder: bool,
}
// HellLocker: a folder header in the preset list.
export struct FolderRow { id: string, name: string, count: string, open: bool, top: length }
export struct ShortcutRow { name: string, label: string, number: string, binding: string, keys: [string], clash: bool }
export enum MonitorRole { automatic, available, unavailable }
export struct MonitorChoice { id: string, role: MonitorRole, name: string, number: string, primary: bool }
