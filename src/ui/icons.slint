// HellLocker: faction and mission icons. Original line drawings on a 24 x 24 grid
// (not game artwork). The index order matches crate::context::{Faction, Mission}::ALL.
export global Icons {
    // Faction colors: Terminids yellow, Automatons red, Illuminate purple; Any is grey.
    public pure function faction-color(index: int) -> color {
        if (index == 1) { return #ffb901; }
        if (index == 2) { return #ff6161; }
        if (index == 3) { return #cd8aea; }
        return #a6adaa;
    }
    public pure function faction(index: int) -> string {
        // 1 Terminids: a beetle seen from above.
        if (index == 1) {
            return "M 12 7 C 15.5 7 17 10 17 13.5 C 17 17.5 15 20.5 12 20.5 C 9 20.5 7 17.5 7 13.5 C 7 10 8.5 7 12 7 Z M 12 7 L 12 20.5 M 10 7.5 L 8.5 4 M 14 7.5 L 15.5 4 M 7.3 11 L 3.5 9 M 7 14 L 3 14 M 7.5 17 L 4 19.5 M 16.7 11 L 20.5 9 M 17 14 L 21 14 M 16.5 17 L 20 19.5";
        }
        // 2 Automatons: a robot head with an antenna.
        if (index == 2) {
            return "M 6 8 L 18 8 L 18 19 L 6 19 Z M 12 8 L 12 4.5 M 10.5 4 L 13.5 4 M 9 11.5 L 10.5 11.5 L 10.5 13 L 9 13 Z M 13.5 11.5 L 15 11.5 L 15 13 L 13.5 13 Z M 9 16 L 15 16 M 6 12 L 4 12 L 4 15 L 6 15 M 18 12 L 20 12 L 20 15 L 18 15";
        }
        // 3 Illuminate: an open eye.
        if (index == 3) {
            return "M 2.5 12 C 6 6.5 18 6.5 21.5 12 C 18 17.5 6 17.5 2.5 12 Z M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z M 12 3 L 12 5 M 5.5 5 L 6.8 6.5 M 18.5 5 L 17.2 6.5";
        }
        // 0 Any: a globe.
        return "M 21 12 A 9 9 0 1 1 3 12 A 9 9 0 1 1 21 12 Z M 3 12 L 21 12 M 12 3 C 8.5 6 8.5 18 12 21 M 12 3 C 15.5 6 15.5 18 12 21";
    }
    public pure function mission(index: int) -> string {
        // 1 Standard: a crosshair.
        if (index == 1) {
            return "M 18 12 A 6 6 0 1 1 6 12 A 6 6 0 1 1 18 12 Z M 12 2.5 L 12 8 M 12 16 L 12 21.5 M 2.5 12 L 8 12 M 16 12 L 21.5 12";
        }
        // 2 Blitz: a lightning bolt.
        if (index == 2) {
            return "M 13.5 2.5 L 5.5 13.5 L 11 13.5 L 10 21.5 L 18.5 10 L 13 10 Z";
        }
        // 3 Eradicate: a skull.
        if (index == 3) {
            return "M 12 3 C 7.5 3 5 6 5 10 C 5 12.5 6.3 14.2 8 15 L 8 18.5 L 16 18.5 L 16 15 C 17.7 14.2 19 12.5 19 10 C 19 6 16.5 3 12 3 Z M 9 9.5 L 10.8 9.5 L 10.8 11.5 L 9 11.5 Z M 13.2 9.5 L 15 9.5 L 15 11.5 L 13.2 11.5 Z M 11 18.5 L 11 21 M 13 18.5 L 13 21";
        }
        // 4 Defense: a shield.
        if (index == 4) {
            return "M 12 2.5 L 19.5 5.5 L 19.5 11 C 19.5 16 16.3 19.6 12 21.5 C 7.7 19.6 4.5 16 4.5 11 L 4.5 5.5 Z M 12 7 L 12 17";
        }
        // 0 Any: four squares.
        return "M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z";
    }
}

export component TagIcon inherits Path {
    in property <string> icon;
    in property <color> color;
    commands: root.icon;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 1.6px;
}

// HellLocker: the faction emblems (supplied by the project owner; transparent PNGs
// made from "Traced by Dogo314" SVGs). Index 0 (Any) has no emblem and uses the globe.
export global FactionArt {
    out property <image> terminids: @image-url("../../assets/faction-terminids.png");
    out property <image> automatons: @image-url("../../assets/faction-automatons.png");
    out property <image> illuminate: @image-url("../../assets/faction-illuminate.png");
    public pure function image(index: int) -> image {
        if (index == 1) { return self.terminids; }
        if (index == 2) { return self.automatons; }
        if (index == 3) { return self.illuminate; }
        return @image-url("");
    }
}

// A faction's emblem, or the grey globe for Any.
export component FactionIcon inherits Rectangle {
    in property <int> faction;
    if (root.faction == 0): TagIcon {
        width: parent.width;
        height: parent.height;
        icon: Icons.faction(0);
        color: Icons.faction-color(0);
    }
    if (root.faction != 0): Image {
        width: parent.width;
        height: parent.height;
        source: FactionArt.image(root.faction);
        image-fit: contain;
    }
}

// HellLocker: sub-faction emblems, in crate::context::Subfaction::ALL order (grouped
// by faction, three each; index 0 = any). Made from "Traced by Dogo314" SVGs supplied
// by the project owner, coloured with their faction's colour.
export global Subfactions {
    out property <[image]> art: [
        @image-url(""),
        @image-url("../../assets/subfaction-predator_strain.png"),
        @image-url("../../assets/subfaction-spore_burst_strain.png"),
        @image-url("../../assets/subfaction-rupture_strain.png"),
        @image-url("../../assets/subfaction-jet_brigade.png"),
        @image-url("../../assets/subfaction-incineration_corps.png"),
        @image-url("../../assets/subfaction-cyborg_legion.png"),
        @image-url("../../assets/subfaction-mindless_masses.png"),
        @image-url("../../assets/subfaction-appropriators.png"),
        @image-url("../../assets/subfaction-vote_snatchers.png"),
    ];
    // The first sub-faction of a faction, and how many it has.
    public pure function first(faction: int) -> int {
        if (faction == 1) { return 1; }
        if (faction == 2) { return 4; }
        if (faction == 3) { return 7; }
        return 0;
    }
    public pure function count(faction: int) -> int {
        return faction >= 1 && faction <= 3 ? 3 : 0;
    }
    public pure function image(index: int) -> image {
        return index > 0 && index < self.art.length ? self.art[index] : @image-url("");
    }
    // A sub-faction's position in its faction's box (0 = "all"), and back.
    public pure function to-local(faction: int, index: int) -> int {
        let first = Subfactions.first(faction);
        return first == 0 || index < first || index >= first + Subfactions.count(faction) ? 0 : index - first + 1;
    }
    public pure function to-global(faction: int, local: int) -> int {
        return local <= 0 || local > Subfactions.count(faction) ? 0 : Subfactions.first(faction) + local - 1;
    }
    // The box's images: none for "all", then the faction's emblems.
    public pure function images(faction: int) -> [image] {
        let f = Subfactions.first(faction);
        if (f == 0) { return [@image-url("")]; }
        return [@image-url(""), Subfactions.image(f), Subfactions.image(f + 1), Subfactions.image(f + 2)];
    }
}
